{
  "repoPath": "/Users/you/src/your-repo",
  "repoSlug": "your-org/your-repo",
  "workDir": "~/.loope/worktrees",

  "eligibleLabel": "ai-agent",
  "mergeResolveLabel": "ai-resolve-merge",
  "pollIntervalSec": 60,
  "ticketsPerCycle": 3,
  "addr": "localhost:8080",
  "personaPath": "~/.loope/persona.md",
  "claudeConfigDir": "~/.claude-personal",
  "maxQARounds": 20,
  "confidenceThreshold": 70,

  "stateLabels": {
    "wip": "ai-wip",
    "done": "ai-done",
    "rework": "ai-rework",
    "needsInfo": "ai-needs-info",
    "stopped": "ai-stopped"
  },

  "githubRetry": { "maxAttempts": 0, "baseDelaySec": 2, "maxDelaySec": 60 },

  "models": {
    "architect": { "model": "opus", "effort": "high" },
    "answerer": { "model": "sonnet", "effort": "medium" },
    "execute": { "model": "opus", "effort": "high" },
    "uat": { "model": "sonnet", "effort": "medium" },
    "codeReview": { "model": "opus", "effort": "medium", "rounds": 2 },
    "mergeResolve": { "model": "opus", "effort": "medium" }
  },

  "telemetry": {
    "serverURL": "http://telemetry-host:9090",
    "token": "your-shared-secret",
    "pushIntervalSec": 15
  }
}
